{
  "appId": "com.atarah.agenthq",
  "appName": "Agent HQ",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scheme": "Agent HQ",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
